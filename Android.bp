package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "CarrierConfig",
    defaults: ["diamaneos_carrier_assets"],
    asset_dirs: ["assets"],
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    required: ["privapp_whitelist_com.android.carrierconfig"],
    aaptflags: ["--keep-raw-values"],
    static_libs: [
        "androidx.annotation_annotation",
        "carrier_config_flags_lib",
    ],
}

// Devices may add authenticated configuration data, never code from the stock
// carrier app. With no asset_module setting the upstream assets are unchanged.
soong_config_module_type {
    name: "diamaneos_carrier_assets_defaults",
    module_type: "java_defaults",
    config_namespace: "diamaneos_carrierconfig",
    value_variables: ["asset_module"],
    properties: ["assets"],
}

diamaneos_carrier_assets_defaults {
    name: "diamaneos_carrier_assets",
    soong_config_variables: {
        asset_module: { assets: [":%s"] },
    },
}

java_aconfig_library {
    name: "carrier_config_flags_lib",
    aconfig_declarations: "carrier_config_flags",
}

aconfig_declarations {
    name: "carrier_config_flags",
    package: "com.android.internal.carrierconfig.flags",
    container: "system_ext",
    srcs: [
        "carrierconfig.aconfig",
    ],
}
